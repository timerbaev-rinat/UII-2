# ===== PostgreSQL =====
POSTGRES_DB=asset_school
POSTGRES_USER=asset_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ===== Backend (FastAPI) =====
# Строка подключения (для локального запуска вне Docker: host=localhost)
DATABASE_URL=postgresql+asyncpg://asset_user:change_me_strong_password@postgres:5432/asset_school

# Секрет для подписи JWT
SECRET_KEY=change_me_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# ===== Backend служебное =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
UPLOAD_DIR=/app/uploads

# ===== Frontend =====
VITE_API_BASE_URL=/api
VITE_APP_TITLE=Учёт имущества школы